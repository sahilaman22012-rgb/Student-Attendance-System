# Use URL-safe characters for the database password, or percent-encode it in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password

# Use a cryptographically random secret with at least 32 characters.
SECRET_KEY=replace-with-a-long-random-secret-key

# Public HTTPS origin for the frontend/reverse proxy.
APP_ORIGIN=https://attendance.example.edu
HTTP_PORT=8080
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
